rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /clients/{document=**} {
      allow read, write: if true;
    }
    match /items/{document=**} {
      allow read, write: if true;
    }
    match /sales/{document=**} {
      allow read, write: if true;
    }
    match /fcm_tokens/{token} {
      allow read, write: if true;
    }
  }
}
